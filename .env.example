# TwelveData API
TWELVEDATA_API_KEY=your_twelvedata_api_key_here

# OpenRouter LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=openrouter/meta-llama/llama-2-70b-chat

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Application Settings
NODE_ENV=production
LOG_LEVEL=info

# Schedule Mode (RECOMMENDED for 2x daily signals)
# Set to 'true' to enable schedule mode (signal at specific hours)
# Set to 'false' for continuous interval-based analysis
SCHEDULE_MODE=true

# Schedule Hours (comma-separated, 24-hour format)
# Default: 7,19 means 7 AM and 7 PM daily
SCHEDULE_HOURS=7,19

# Interval Mode (only used when SCHEDULE_MODE=false)
# Analysis interval in minutes
INTERVAL_MINUTES=5

# Use Top Coins from CoinGecko
# Set to 'true' to use top coins (FREE, no API key needed)
# Set to 'false' to use CRYPTO_SYMBOLS below
USE_TOP_COINS=true

# Top Coins Limit (only used when USE_TOP_COINS=true)
# Number of top coins to analyze (recommended: 50)
TOP_COINS_LIMIT=50

# Top Signals to Send (how many of the best signals to send via Telegram)
# Recommended: 5 (only send 5 best signals out of total analyzed)
TOP_SIGNALS_TO_SEND=5

# Crypto Symbols to Track (only used when USE_TOP_COINS=false)
# Comma-separated list
CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD

# RSI Settings
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# MACD Settings
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Bollinger Bands Settings
BB_PERIOD=20
BB_STD_DEV=2

# Risk Management
RISK_REWARD_RATIO=2
POS_SIZE_PERCENT=1
